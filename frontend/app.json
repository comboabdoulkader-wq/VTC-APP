{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.vtcplatform.q33vdy",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Partager votre position pour le suivi de course en direct",
        "NSCameraUsageDescription": "Photographier vos documents et selfie de vérification",
        "NSPhotoLibraryUsageDescription": "Importer vos documents depuis vos photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.vtcplatform.q33vdy",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-vector-icons/material-design-icons",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Photographier vos documents et selfie de vérification",
          "photosPermission": "Importer vos documents depuis vos photos"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Partager votre position pour le suivi de course en direct"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#000000"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
